      "content": {
        "lecture_id": "MS-134",
        "title": "행방불명자 조사와 고발 보고",
        "subtitle": "소재 조사와 정기 보고의 기한",
        "layout": "numbers",
        "source_keys": [
          "병역법|시행령|164",
          "병역법|시행령|165",
          "병역법|시행규칙|116",
          "병역법|시행규칙|117"
        ],
        "sections": [
          {
            "heading": "소재 조사",
            "items": [
              {
                "label": "지방병무청장",
                "text": "행방불명으로 통지서 교부 불가능 시 소재 조사 의무",
                "ref": "영 제164조제1항"
              },
              {
                "label": "30일 이내",
                "text": "경찰관서가 조사 의뢰를 받으면 조사결과 통보",
                "ref": "영 제164조제2항"
              }
            ]
          },
          {
            "heading": "고발·보고",
            "items": [
              {
                "label": "지체 없이",
                "text": "정당한 사유 없는 검사·징집·소집 기피 등은 관할 수사기관에 고발",
                "ref": "영 제165조제1항"
              },
              {
                "label": "다음 달 10일까지",
                "text": "지방병무청장은 분기별 기피자·행방불명자·복무이탈자 현황을 종합 보고",
                "ref": "규칙 제116조제3항·제117조제6항"
              }
            ]
          }
        ]
      },
