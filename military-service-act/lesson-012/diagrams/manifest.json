        "sections": [
          {
            "heading": "조사 대상·업무",
            "items": [
              {
                "label": "다음 해 검사 대상",
                "text": "매년 다음 해 병역판정검사를 받아야 할 사람을 조사",
                "ref": "법 제10조제1항"
              },
              {
                "label": "주민등록 오류 등",
                "text": "기재 내용이 명백히 잘못되거나 정정된 사람 중 검사 대상자도 조사",
                "ref": "법 제10조제1항"
              },
              {
                "label": "데이터베이스",
                "text": "병적 데이터베이스를 작성하여 병역판정검사를 받게 하여야 함",
                "ref": "법 제10조제1항"
              }
            ]
          },
          {
            "heading": "조사 일정",
            "items": [
              {
                "label": "9월 15일까지",
                "text": "지방병무청장이 조사 후 결과 입력·정리, 대상자 현황서 작성·관리",
                "ref": "시행령 제8조제1항"
              },
              {
                "label": "9월 30일까지",
                "text": "대상자 현황서를 병무청장에게 제출",
                "ref": "시행령 제8조제2항"
              }
            ]
          }
        ]
