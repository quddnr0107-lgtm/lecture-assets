      "content": {
        "lecture_id": "MS-039",
        "title": "추천에 의한 전환복무",
        "subtitle": "법에 규정된 추천·입영·군사교육·전환의 절차",
        "layout": "flow",
        "source_keys": [
          "병역법|본법|25"
        ],
        "sections": [
          {
            "heading": "임용예정자 등의 추천",
            "items": [
              {
                "label": "각 기관의 장",
                "text": "소방청장은 의무소방원, 경찰청장·해양경찰청장은 의무경찰 임용예정자 등을 국방부장관에게 추천",
                "ref": "법 제25조제1항"
              }
            ]
          },
          {
            "heading": "현역병으로 입영",
            "items": [
              {
                "label": "국방부장관",
                "text": "추천받은 사람을 현역병지원자로 보아 지방병무청장이 입영하게 함",
                "ref": "법 제25조제1항"
              }
            ]
          },
          {
            "heading": "군사교육 후 전환",
            "items": [
              {
                "label": "전환복무 가능",
                "text": "정하여진 군사교육을 마치게 한 후 전환복무시킬 수 있음",
                "ref": "법 제25조제1항"
              }
            ]
          },
          {
            "heading": "복무를 마친 뒤",
            "items": [
              {
                "label": "국방부장관",
                "text": "전환복무를 해제하고 예비역에 편입",
                "ref": "법 제25조제5항"
              }
            ]
          }
        ]
      },
      "lecture_title": "병역법 제25조, 추천에 의한 전환복무",
      "main_article": "병역법 제25조",
