      "content": {
        "lecture_id": "MS-005",
        "title": "역종별 신분과 병적 관리",
        "subtitle": "신분 구분과 병적관리기관을 함께 확인",
        "layout": "compare",
        "source_keys": [
          "병역법|본법|5",
          "병역법|시행령|2"
        ],
        "sections": [
          {
            "heading": "역종별 신분",
            "items": [
              {
                "label": "예비역·보충역",
                "text": "각각 장교·준사관·부사관 또는 병으로 구분",
                "ref": "법 제5조제2항"
              },
              {
                "label": "전시근로역",
                "text": "부사관 또는 병으로 구분",
                "ref": "법 제5조제2항"
              },
              {
                "label": "병적 편입",
                "text": "각각 그 병역의 병적에 편입",
                "ref": "법 제5조제3항"
              }
            ]
          },
          {
            "heading": "병적관리기관",
            "items": [
              {
                "label": "군 입영·상근소집",
                "text": "해당 군 참모총장 — 해병대는 해병대사령관",
                "ref": "시행령 제2조제1항제1호"
              },
              {
                "label": "전환복무 중",
                "text": "경찰청장·소방청장 또는 해양경찰청장",
                "ref": "시행령 제2조제1항제2호"
              },
              {
                "label": "그 밖의 해당 역",
                "text": "병역준비역·전시근로역·예비역·보충역·대체역은 거주지 지방병무청장 또는 병무지청장",
                "ref": "시행령 제2조제1항제3호"
              }
            ]
          }
        ]
      },
