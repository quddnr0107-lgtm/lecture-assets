        "sections": [
          {
            "heading": "고용주의 복무위반",
            "items": [
              {
                "label": "위반행위",
                "text": "대표이사 4촌 이내 혈족의 편입·전직 또는 지정업체 해당 분야 미복무",
                "ref": "법 제92조제1항"
              },
              {
                "label": "법정형",
                "text": "200만원 이상 2천만원 이하의 벌금",
                "ref": "법 제92조제1항"
              }
            ]
          },
          {
            "heading": "소집 후순위 부정",
            "items": [
              {
                "label": "행위자·행위",
                "text": "고용주 또는 국가기능검정·면허사무 취급자의 제67조 후순위 조정 부정행위",
                "ref": "법 제92조제2항"
              },
              {
                "label": "법정형",
                "text": "3년 이하의 징역",
                "ref": "법 제92조제2항"
              }
            ]
          }
        ]
