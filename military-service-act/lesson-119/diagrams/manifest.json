      "content": {
        "lecture_id": "MS-119",
        "title": "공상 치료와 검사 중 부상",
        "subtitle": "치료의 근거와 국가 부담의 범위",
        "layout": "compare",
        "source_keys": [
          "병역법|본법|75"
        ],
        "sections": [
          {
            "heading": "복무 중 공상·질병",
            "items": [
              {
                "label": "사회·대체복무",
                "text": "국가·지자체·공공단체 등의 부담으로 공상·공무상 질병 치료",
                "ref": "법 제75조제4항"
              },
              {
                "label": "군사교육",
                "text": "군사교육소집·학생군사교육이 직접 원인인 사망·부상에도 준용",
                "ref": "법 제75조제5항"
              }
            ]
          },
          {
            "heading": "국가 부담 치료 가능",
            "items": [
              {
                "label": "검사·입영",
                "text": "검사가 직접 원인인 치료 필요자 및 징집·소집 입영 중 부상자",
                "ref": "법 제75조제6항제1호·제2호"
              },
              {
                "label": "검사 전후 이동",
                "text": "지정장소로 직접 이동 중 또는 검사 후 지체 없이 귀가 중 부상자",
                "ref": "법 제75조제6항제4호"
              }
            ]
          }
        ],
        "takeaway": "동원소집등 임무·훈련 중 부상자는 예비군법 제9조 준용"
      },
