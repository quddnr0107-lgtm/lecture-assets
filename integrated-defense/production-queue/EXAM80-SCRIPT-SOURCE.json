  "user_instruction": "80회 기준, 기존 스크립트로 제작",
  "confirmed_at_kst": "2026-11-27T12:02:16+09:00",
  "content_authority": "기존 제80회 통합방위법 합본 강의 스크립트 25편",
  "script_source_commit": "ca55be300f0280bb52e874eb93c540ca76c5c16f",
