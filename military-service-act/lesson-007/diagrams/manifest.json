      "content": {
        "lecture_id": "MS-007",
        "title": "병역 통지서의 송달",
        "subtitle": "송달 방법·기한·수령 확인의 기본 구조",
        "layout": "compare",
        "source_keys": [
          "병역법|본법|6"
        ],
        "sections": [
          {
            "heading": "송달과 확인",
            "items": [
              {
                "label": "송달 주체·방법",
                "text": "지방병무청장·병무지청장이 우편·교부 또는 전자송달",
                "ref": "법 제6조제1항"
              },
              {
                "label": "수령증",
                "text": "수령증을 받아야 함. 등기우편은 수령사실 확인 등으로 갈음 가능",
                "ref": "법 제6조제4항"
              },
              {
                "label": "전자송달",
                "text": "수신자가 동의하는 경우에 한하여 송달",
                "ref": "법 제6조제10항"
              }
            ]
          },
          {
            "heading": "송달기한",
            "items": [
              {
                "label": "원칙 30일 전",
                "text": "병역의무 이행일 30일 전까지 송달되어야 함",
                "ref": "법 제6조제2항"
              },
              {
                "label": "예외 7일 전",
                "text": "병력동원훈련·전시근로소집점검 등 대통령령이 정한 경우",
                "ref": "법 제6조제2항"
              },
              {
                "label": "기한의 특례",
                "text": "천재지변·전시·사변 등 대통령령이 정한 경우에는 대통령령으로 달리 정할 수 있음",
                "ref": "법 제6조제3항"
              }
            ]
          }
        ]
      },
      "lecture_title": "병역법 제6조, 병역의무부과 통지서의 송달",
