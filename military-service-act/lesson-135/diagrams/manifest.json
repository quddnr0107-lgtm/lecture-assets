        "sections": [
          {
            "heading": "11명 구성",
            "items": [
              {
                "label": "위원장 1명",
                "text": "관할 지방병무청 병역판정관 또는 징집·소집 담당 과장급 중 지명",
                "ref": "영 제161조제1항·제2항"
              },
              {
                "label": "위원 10명",
                "text": "소속 공무원 4명 + 학식·경험이 풍부한 위촉위원 6명",
                "ref": "영 제161조제2항"
              }
            ]
          },
          {
            "heading": "임기·회의",
            "items": [
              {
                "label": "위촉위원 2년",
                "text": "민간 위촉위원의 임기는 2년",
                "ref": "영 제161조제3항"
              },
              {
                "label": "의결 기준",
                "text": "재적위원 과반수 출석, 출석위원 과반수 찬성",
                "ref": "영 제161조제4항"
              }
            ]
          }
