      "content": {
        "lecture_id": "MS-129",
        "title": "병무행정 권한의 위임",
        "subtitle": "대통령령에 따라 권한을 위임할 수 있음",
        "layout": "compare",
        "source_keys": [
          "병역법|본법|78"
        ],
        "sections": [
          {
            "heading": "국내 기관 위임",
            "items": [
              {
                "label": "병무청장",
                "text": "제78조제1항의 열거된 권한을 지방병무청장 또는 그 소속기관장에게 위임 가능",
                "ref": "법 제78조제1항"
              },
              {
                "label": "지방병무청장",
                "text": "이 법에 따른 권한 일부를 소속기관장에게 위임 가능",
                "ref": "법 제78조제2항"
              }
            ]
          },
          {
            "heading": "재외공관장 위임",
            "items": [
              {
                "label": "병무청장의 권한",
                "text": "제70조제3항에 따른 권한 일부를 재외공관장에게 위임 가능",
                "ref": "법 제78조제3항"
              },
              {
                "label": "지방병무청장의 권한",
                "text": "제60조제1항제2호에 따른 권한 일부를 재외공관장에게 위임 가능",
                "ref": "법 제78조제3항"
              }
            ]
          }
        ]
