        "sections": [
          {
            "heading": "통지서 송달",
            "items": [
              {
                "label": "검사일 30일 전까지",
                "text": "본인에게 확인신체검사 통지서 송달",
                "ref": "영 제155조의2제3항"
              },
              {
                "label": "검사일 7일 전까지",
                "text": "병역면탈 증거 인멸 또는 도주 우려가 있는 경우",
                "ref": "영 제155조의2제3항 단서"
              }
            ]
          },
          {
            "heading": "자료·처분",
            "items": [
              {
                "label": "정보 사용 제한",
                "text": "취득한 정보·자료의 공개·누설·제공 및 확인신체검사 외 목적 사용 금지",
                "ref": "법 제77조의2제3항"
              },
              {
                "label": "잘못된 병역처분",
                "text": "검사 결과 잘못되었다고 판단하면 대통령령에 따라 처분 변경 의무",
                "ref": "법 제77조의2제4항"
              }
            ]
          }
        ]
