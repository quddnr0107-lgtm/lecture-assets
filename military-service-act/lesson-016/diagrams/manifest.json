        "sections": [
          {
            "heading": "파견 요청 요건",
            "items": [
              {
                "label": "업무 수행 곤란",
                "text": "병역판정검사전담의사·전문의사만으로 신체검사업무 등을 수행하기 어렵다고 병무청장이 인정",
                "ref": "법 제12조의2제1항"
              }
            ]
          },
          {
            "heading": "병무청장",
            "items": [
              {
                "label": "요청할 수 있음",
                "text": "신체검사에 필요한 전문분야별 군의관의 파견을 국방부장관에게 요청",
                "ref": "시행령 제13조의2제1항"
              }
            ]
          },
          {
            "heading": "국방부장관",
            "items": [
              {
                "label": "파견하여야 함",
                "text": "요청을 받은 경우 군의관을 파견",
                "ref": "시행령 제13조의2제2항"
              }
            ]
          }
        ]
      },
