      "content": {
        "lecture_id": "MS-164",
        "title": "과태료의 부과·징수 절차",
        "subtitle": "병무청장 부과와 세무서장 위탁징수",
        "layout": "flow",
        "source_keys": [
          "병역법|본법|95",
          "병역법|시행규칙|123"
        ],
        "sections": [
          {
            "heading": "부과·징수",
            "items": [
              {
                "label": "병무청장",
                "text": "대통령령에 따라 과태료를 부과·징수",
                "ref": "법 제95조제6항"
              }
            ]
          },
          {
            "heading": "대장 정리",
            "items": [
              {
                "label": "병무청장",
                "text": "부과하거나 징수한 내용을 과태료 부과 및 징수 대장에 기재·정리",
                "ref": "규칙 제123조제1항"
              }
            ]
          },
          {
            "heading": "위탁징수",
            "items": [
              {
                "label": "이의 없이 미납",
                "text": "이의를 제기하지 않고 납부하지 않으면 관할 세무서장에게 위탁하여 징수",
                "ref": "법 제95조제7항"
              }
            ]
          },
          {
            "heading": "서류 송부",
            "items": [
              {
                "label": "병무청장",
                "text": "위탁징수 시 관련 사실관계 서류를 관할 세무서장에게 송부",
                "ref": "규칙 제123조제2항"
              }
            ]
          }
        ]
      },
