        "sections": [
          {
            "heading": "신고·출원 방식",
            "items": [
              {
                "label": "원칙",
                "text": "문서로 하여야 하며 전자문서도 포함",
                "ref": "법 제5조의2제1항"
              },
              {
                "label": "예외",
                "text": "병무청장이 정하는 경우 정보통신망·구술·전화·전신·팩스 이용 가능",
                "ref": "법 제5조의2제1항"
